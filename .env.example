# Local MCP credentials. Never commit the real .env.
# MCP clients (Hermes, Claude Code/Desktop, VS Code) use their OWN LLM settings.
# No Azure/OpenAI/Anthropic/Gemini key is required to run this server.
# Public book search, notices and academic calendar need no school credentials.
YONSEI_ID=<your-yonsei-id>
YONSEI_PASSWORD=<your-yonsei-password>

# Show Chromium for first login/manual MFA. Use false for unattended operation
# only after verifying normal authentication. Never bypass CAPTCHA/MFA.
YONSEI_HEADED=true
# Relative to the server working directory; account/system paths are derived.
YONSEI_STORAGE_STATE=.session/learnus.json
# Optional login wait limit (not a global tool timeout).
# YONSEI_NAV_TIMEOUT_MS=30000

# Optional developer-only LLM configuration: .env.llm.example
# That example is NOT loaded automatically. Do not change these for normal MCP use.
RUN_LIVE_PORTAL=0
RUN_LIVE_LLM=0
