# 로컬 MCP의 학교 로그인 설정입니다. 실제 .env는 절대 커밋하지 마세요.
# Hermes·Claude Code/Desktop·VS Code의 LLM은 각 클라이언트에서 설정합니다.
# 이 서버 실행에는 Azure/OpenAI/Anthropic/Gemini 키가 필요하지 않습니다.
# 공개 도서 검색·공지·학사일정은 학교 자격 증명 없이 사용할 수 있습니다.
YONSEI_ID=<your-yonsei-id>
YONSEI_PASSWORD=<your-yonsei-password>

# 최초 로그인·수동 추가 인증을 위해 브라우저를 표시합니다.
# 정상 인증을 확인한 뒤에만 무인 실행용 false를 사용하세요. CAPTCHA/MFA는 우회하지 않습니다.
YONSEI_HEADED=true
# 서버 작업 디렉터리 기준 경로입니다. 실제 쿠키는 계정·시스템별 하위 경로에 저장됩니다.
YONSEI_STORAGE_STATE=.session/learnus.json
# 선택 사항: 로그인 대기 제한이며 모든 도구 호출의 전역 제한은 아닙니다.
# YONSEI_NAV_TIMEOUT_MS=30000

# 선택적 개발용 LLM 설정은 .env.llm.example을 참고하세요.
# 별도 예제 파일은 자동 로딩되지 않습니다. 일반 MCP 사용에는 아래 값을 변경하지 마세요.
RUN_LIVE_PORTAL=0
RUN_LIVE_LLM=0
