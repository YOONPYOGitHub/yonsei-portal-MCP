# Yonsei Portal credentials (DO NOT COMMIT THE REAL .env)
# 학번 (Student/Staff ID)
YONSEI_ID=<your-yonsei-id>
# 통합인증 비밀번호 (Password)
YONSEI_PASSWORD=<your-yonsei-password>

# Optional: run browser with a visible window for debugging / manual OTP entry
# true  -> headed (you can see the browser, type OTP/captcha manually)
# false -> headless
YONSEI_HEADED=true

# Where to cache the logged-in browser session (cookies). Keep out of git.
YONSEI_STORAGE_STATE=.session/storage_state.json

# ---------------------------------------------------------------------------
# LLM integration test harness (tests/llm) — only needed to run real-LLM tests.
# Pick ONE provider; the harness selects it from LLM_PROVIDER (or the
# `make_provider("...")` argument, which takes precedence).
#   azure-openai | openai | anthropic | stub
# ---------------------------------------------------------------------------
LLM_PROVIDER=azure-openai

# --- Azure OpenAI (through APIM) ---
# Auth is decided automatically from whichever key(s) you fill in:
#   * AOAI-key mode      -> set AZURE_OPENAI_API_KEY (sent as `api-key`).
#   * Keyless/APIM mode  -> leave AZURE_OPENAI_API_KEY empty; the harness reuses
#     AZURE_OPENAI_APIM_SUBSCRIPTION_KEY for the SDK's required `api-key` slot.
# The APIM subscription key, when set, is ALWAYS also sent as
# `Ocp-Apim-Subscription-Key`. This workshop backend is keyless (APIM
# authenticates to AOAI with its managed identity), so only the APIM key is needed.
# Gateway/base URL (no trailing path); the SDK appends /openai/deployments/...
AZURE_OPENAI_ENDPOINT=https://<your-apim-name>.azure-api.net
# Deployment (model) name as registered in Azure OpenAI / surfaced by APIM
# e.g. gpt-5.4-mini, gpt-4o-mini
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
# API version your deployment supports, e.g. 2024-10-21
AZURE_OPENAI_API_VERSION=<your-api-version>
# Usually empty for a keyless APIM-fronted backend; set only if your gateway
# forwards a real Azure OpenAI api-key.
AZURE_OPENAI_API_KEY=
# Sent as `Ocp-Apim-Subscription-Key` — required by this APIM product.
AZURE_OPENAI_APIM_SUBSCRIPTION_KEY=<your-apim-subscription-key>

# --- OpenAI (api.openai.com or compatible) ---
OPENAI_API_KEY=<your-openai-api-key>
# Chat model name, e.g. gpt-4o-mini, gpt-4o
OPENAI_MODEL=<your-openai-model>
# Optional base_url for OpenAI-compatible gateways (leave empty for api.openai.com)
OPENAI_BASE_URL=

# --- Anthropic ---
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Model name, e.g. claude-3-5-sonnet-latest
ANTHROPIC_MODEL=<your-anthropic-model>

# Set to 1 to allow the opt-in L3 test (real portal login + real LLM).
RUN_LIVE_LLM=0
