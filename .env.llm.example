# OPTIONAL developer test/demo configuration, NOT MCP server configuration.
# Normal Hermes/Claude/VS Code use does not use these keys.
# Install the llm extra only when you need the integration harness.
# This file and .env.llm are NOT automatically loaded by the application.
# Set the required fields in your private process environment, or selectively
# copy them into your existing private .env; never overwrite your school settings.
# Do not commit real keys. Actual LLM runs may send school data to the provider
# and incur charges. See docs/DEVELOPMENT.md and SECURITY.md.
LLM_PROVIDER=azure-openai

# Azure OpenAI, optionally via Azure API Management.
# v1 uses stateless Responses (store=False). Use a gateway/resource root URL.
AZURE_OPENAI_ENDPOINT=https://<your-resource-or-gateway-host>
AZURE_OPENAI_DEPLOYMENT=<your-authorized-deployment-name>
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_API_KEY=
# If set, also sent as Ocp-Apim-Subscription-Key. Keyless APIM mode uses this
# as SDK credential when AZURE_OPENAI_API_KEY is empty. Backend auth is your setup.
AZURE_OPENAI_APIM_SUBSCRIPTION_KEY=

# Direct or compatible OpenAI. Select a model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=<your-model-id>
OPENAI_BASE_URL=

# Anthropic API, not Claude Code subscription/login configuration.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=<your-model-id>

# Gemini through its OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=<your-model-id>
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Only enable intentionally for the documented real-portal + real-LLM runner.
RUN_LIVE_LLM=0
