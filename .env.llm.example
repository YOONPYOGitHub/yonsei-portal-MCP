# 선택적 개발 테스트·데모 설정입니다. MCP 서버 자체의 LLM 설정이 아닙니다.
# 일반적인 Hermes·Claude·VS Code 연동에서는 이 키를 사용하지 않습니다.
# LLM 통합 테스트가 필요한 경우에만 llm 선택 의존성을 설치하세요.
# 이 파일과 .env.llm은 애플리케이션이 자동으로 읽지 않습니다.
# 필요한 항목을 비공개 프로세스 환경에 설정하거나 기존 개인 .env에 선택적으로 복사하세요.
# 기존 학교 계정 설정을 덮어쓰지 마세요. 실제 키를 커밋해서는 안 됩니다.
# 실제 LLM 실행은 학교 데이터를 제공자에게 전송하고 비용을 발생시킬 수 있습니다.
# docs/DEVELOPMENT.md와 SECURITY.md를 먼저 확인하세요.
LLM_PROVIDER=azure-openai

# Azure OpenAI 연결입니다. 필요하면 Azure API Management를 경유할 수 있습니다.
# v1은 상태를 저장하지 않는 Responses(store=False)를 사용합니다. 리소스·게이트웨이 루트 URL을 입력하세요.
AZURE_OPENAI_ENDPOINT=https://<your-resource-or-gateway-host>
AZURE_OPENAI_DEPLOYMENT=<your-authorized-deployment-name>
AZURE_OPENAI_API_VERSION=v1
AZURE_OPENAI_API_KEY=
# 설정하면 Ocp-Apim-Subscription-Key 헤더에도 전송됩니다.
# Azure 키가 비어 있는 APIM 방식에서는 이 값을 SDK 자격 증명으로도 사용합니다.
# 게이트웨이에서 Azure로 연결하는 인증은 별도로 구성해야 합니다.
AZURE_OPENAI_APIM_SUBSCRIPTION_KEY=

# 직접 또는 호환 엔드포인트를 통한 OpenAI 연결입니다. 본인 계정에서 사용 가능한 모델을 선택하세요.
OPENAI_API_KEY=
OPENAI_MODEL=<your-model-id>
OPENAI_BASE_URL=

# Anthropic API 설정입니다. Claude Code 구독·로그인 설정과는 다릅니다.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=<your-model-id>

# OpenAI 호환 엔드포인트를 통한 Gemini 연결입니다.
GEMINI_API_KEY=
GEMINI_MODEL=<your-model-id>
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# 문서에 안내한 실제 포털·LLM 테스트를 의도적으로 실행할 때만 활성화하세요.
RUN_LIVE_LLM=0
